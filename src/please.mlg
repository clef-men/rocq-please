DECLARE PLUGIN "rocq-please.plugin"

{

open Stdarg

}

VERNAC ARGUMENT EXTEND derive_kind
| [ "Inhabited" ] ->
    { Derive.Inhabited }
| [ "EqDecision" ] ->
    { Derive.Eq_decision }
| [ "Countable" ] ->
    { Derive.Countable }
END

VERNAC COMMAND EXTEND Please
  CLASSIFIED AS SIDEFF
| #[ locality = Attributes.hint_locality_default_superglobal ]
  [ "Please" "derive" derive_kind(kind) "for" reference(ty) ] ->
    { Derive.derive ~locality ~kind ~ty }
END
