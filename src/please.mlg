DECLARE PLUGIN "rocq-please.plugin"

{

open Procq.Constr
open Procq.Prim
open Stdarg

let def_body =
  G_vernac.def_body

}

VERNAC ARGUMENT EXTEND please_derive_kind
| [ "Inhabited" ] ->
    { Please_derive.Inhabited }
| [ "EqDecision" ] ->
    { Please_derive.Eq_decision }
| [ "Countable" ] ->
    { Please_derive.Countable }
END

VERNAC COMMAND EXTEND please_derive
  CLASSIFIED AS SIDEFF
| #[ locality = Attributes.hint_locality_default_superglobal ]
  [ "Please" "derive" please_derive_kind(kind) "for" reference(ty) ]
  ->
    { Please_derive.interp ~locality ~kind ~ty }
END

VERNAC ARGUMENT EXTEND please_definition
| [ "Definition" identref(id) def_body(def) ] ->
    { id, def }
END

VERNAC COMMAND EXTEND please_definition
  CLASSIFIED AS SIDEFF
| [ "Please" please_definition(def) ]
  ->
    { let id, def = def in
      Please_opacify.interp_register ~locality:None id def
    }
| #[ locality = Attributes.explicit_hint_locality ]
  [ "Please" please_definition(def) ]
  ->
    { let id, def = def in
      Please_opacify.interp_register ~locality id def
    }
END

VERNAC COMMAND EXTEND please_opacify
  CLASSIFIED AS SIDEFF
| [ "Please" "opacify" ]
  ->
    { Please_opacify.interp_opacify () }
END

VERNAC COMMAND EXTEND please_begin
  CLASSIFIED AS SIDEFF
| [ "Please" "begin" ]
  ->
    { Please_opacify.interp_begin () }
END

VERNAC COMMAND EXTEND please_end
  CLASSIFIED AS SIDEFF
| [ "Please" "end" ]
  ->
    { Please_opacify.interp_end () }
END
