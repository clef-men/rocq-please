# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Common Rocq utilities"
maintainer: ["clement.allain@cs.au.dk"]
authors: ["Clément Allain"]
license: "ISC"
homepage: "https://github.com/clef-men/rocq-please"
bug-reports: "https://github.com/clef-men/rocq-please/issues"
depends: [
  "dune" {>= "3.21"}
  "rocq-core" {= "9.2.0"}
  "rocq-stdlib" {= "9.2.0"}
  "rocq-stdpp"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/clef-men/rocq-please.git"
x-maintenance-intent: ["(latest)"]
